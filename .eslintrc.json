{
  "root": true,
  "extends": ["next/core-web-vitals", "next/typescript"],
  "rules": {
    "@typescript-eslint/no-unused-vars": [
      "warn",
      { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_", "ignoreRestSiblings": true }
    ]
  },
  "ignorePatterns": [
    "node_modules/",
    ".next/",
    ".vercel/",
    ".wrangler/",
    ".superpowers/",
    "next-env.d.ts"
  ]
}
