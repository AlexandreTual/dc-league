{
  "name": "dc-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "vitest run",
    "postinstall": "node scripts/patch-next-on-pages.mjs",
    "pages:dev": "wrangler pages dev",
    "game:dev": "cd workers/game && wrangler dev --port 8787 --persist-to ../../.wrangler/state",
    "pages:deploy": "wrangler pages deploy",
    "db:migrate:local": "wrangler d1 migrations apply dc-league --local",
    "db:migrate:remote": "wrangler d1 migrations apply dc-league --remote"
  },
  "dependencies": {
    "@cloudflare/next-on-pages": "1.13.16",
    "@dnd-kit/core": "^6.3.1",
    "lucide-react": "^0.454.0",
    "next": "^15.1.0",
    "react": "^18",
    "react-dom": "^18"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241205.0",
    "@types/node": "^22.20.5",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.0.1",
    "eslint": "^8",
    "eslint-config-next": "^15.1.0",
    "playwright-core": "^1.63.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "^5.0.3",
    "wrangler": "^4.86.0"
  }
}
